# Copy this file to .env and fill in real values. Never commit .env.

# App server (player + admin + API)
PORT=3001

# Simple admin login (replace later)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Temporary player accounts live in data/users.json (plain passwords, replace later).

# DeepSeek (OpenAI-compatible). Key stays on the server only.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_API_KEY=
