{
  "name": "tiddeliquiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA quiz app with a Node server and an OpenAI-compatible AI backend",
  "scripts": {
    "dev": "node --use-system-ca --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs watch --exclude \"./src/client/**\" --exclude \"./data/**\" src/server/index.ts",
    "build": "vite build",
    "start": "node --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs src/server/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.53",
    "@hono/node-server": "^1.19.6",
    "ai": "^5.0.60",
    "hono": "^4.10.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
